{
  "name": "bookorbit-mcp",
  "version": "0.1.0",
  "description": "MCP server that exposes the text of ebooks managed by BookOrbit to LLMs, without overwhelming them.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Oliver Graff; portions Josh Strange (MIT)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ograff/bookorbit-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bookorbit",
    "epub",
    "ebooks",
    "llm"
  ],
  "bin": {
    "bookorbit-mcp": "dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/stdio.js",
    "dev": "node --import tsx src/stdio.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "setup:types": "bash scripts/setup-types.sh"
  },
  "dependencies": {
    "@bookorbit/types": "file:vendor/bookorbit/packages/types",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jose": "^6.2.15",
    "node-html-parser": "^7.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0"
  }
}
